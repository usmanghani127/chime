{
  "name": "chime",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "lint-staged": "lint-staged",
    "tsc": "tsc -p ./tsconfig.json --noEmit",
    "start": "yarn clean:watchman; react-native start --reset-cache",
    "test": "jest",
    "clean:watchman": "watchman watch-del-all",
    "clean:gradle": "cd android; ./gradlew :app:clean",
    "clean:interactive": "react-native clean-project",
    "clean:all": "react-native clean-project-auto; rm -rf yarn.lock, rm -rf ios/Podfile.lock; yarn install:all",
    "install:pods": "pod install --project-directory=ios --verbose",
    "install:all": "yarn install; yarn install:pods",
    "release:apk": "cd android; ./gradlew :app:assembleRelease",
    "debug:apk": "cd android; ./gradlew :app:assembleDebug",
    "release:aab": "cd android; ./gradlew :app:bundleRelease",
    "prepare": "husky"
  },
  "dependencies": {
    "@react-navigation/native": "6.1.17",
    "@react-navigation/native-stack": "6.9.26",
    "react": "18.2.0",
    "react-native": "0.73.6",
    "react-native-localization": "2.3.2",
    "react-native-safe-area-context": "4.9.0",
    "react-native-screens": "3.30.1",
    "react-native-splash-screen": "3.3.0",
    "react-native-vector-icons": "10.0.3"
  },
  "devDependencies": {
    "@babel/core": "7.24.4",
    "@babel/preset-env": "7.24.4",
    "@babel/runtime": "7.24.4",
    "@react-native/babel-preset": "0.73.21",
    "@react-native/eslint-config": "0.73.2",
    "@react-native/metro-config": "0.73.5",
    "@react-native/typescript-config": "0.73.1",
    "@types/react": "18.2.6",
    "@types/react-native-vector-icons": "6.4.18",
    "@types/react-test-renderer": "18.0.0",
    "babel-jest": "29.6.3",
    "eslint": "8.19.0",
    "husky": "9.0.11",
    "jest": "29.6.3",
    "lint-staged": "15.2.2",
    "prettier": "2.8.8",
    "react-native-clean-project": "4.0.3",
    "react-test-renderer": "18.2.0",
    "typescript": "5.0.4"
  },
  "engines": {
    "node": ">=18"
  },
  "resolutions": {
    "@types/react": "18.2.6"
  }
}
